<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/song_cell_selected" />
            <stroke
                android:width="2dp"
                android:color="@color/circle_active" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/song_cell_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/song_cell_background" />
            <stroke
                android:width="1dp"
                android:color="@color/song_cell_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
