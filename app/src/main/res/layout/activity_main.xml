<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/rootButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_root"
            android:clickable="true"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/note_c"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/mode_scale"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tunerButton"
            style="@style/ChipButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:drawableStart="@drawable/ic_tuner"
            android:drawablePadding="6dp"
            android:drawableTint="@color/text_primary"
            android:text="@string/tuner" />

        <TextView
            android:id="@+id/colorsButton"
            style="@style/ChipButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_color"
            android:drawablePadding="6dp"
            android:drawableTint="@color/text_primary"
            android:text="@string/color" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/chip_border" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_background"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/modeButton"
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/mode_scale" />

            <TextView
                android:id="@+id/scaleButton"
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/mode_scale" />

            <TextView
                android:id="@+id/sequenceButton"
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/sequence" />

            <TextView
                android:id="@+id/chordsButton"
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/chords" />

            <TextView
                android:id="@+id/degreesButton"
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/degrees" />

            <TextView
                android:id="@+id/strumButton"
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:drawableStart="@drawable/ic_pick"
                android:drawablePadding="6dp"
                android:drawableTint="@color/text_primary"
                android:text="@string/pick" />

            <TextView
                android:id="@+id/guideButton"
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/chord_guide" />

            <ImageView
                android:id="@+id/settingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:contentDescription="@string/settings"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/chip_border" />

    <apk.mavier.dguitar.presentation.ui.FretboardView
        android:id="@+id/fretboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/fretboard_description" />
</LinearLayout>

