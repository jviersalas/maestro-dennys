<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/back_symbol"
                android:textColor="@color/text_primary"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/improvisation"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/improvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/improv_subtitle_placeholder"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <apk.mavier.dguitar.presentation.ui.ChordDiagramView
                android:id="@+id/improvChordDiagram"
                android:layout_width="88dp"
                android:layout_height="60dp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/optionsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/options"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="@color/icon_tint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/headerControls"
            android:layout_width="272dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_control_bar"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tempoButton"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button"
                android:clickable="true"
                android:contentDescription="@string/tempo_description"
                android:drawablePadding="1dp"
                app:drawableTint="@color/icon_tint"
                app:drawableTopCompat="@drawable/ic_tempo"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/tempo_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />

            <ImageButton
                android:id="@+id/metronomeButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/metronome_enable"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_metronome"
                app:tint="@color/icon_tint" />

            <ImageButton
                android:id="@+id/colorsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/colors_show_scale"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_color"
                app:tint="@color/icon_tint" />

            <ImageButton
                android:id="@+id/degreesButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/degrees_show_chord"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_degrees"
                app:tint="@color/icon_tint" />

            <ImageButton
                android:id="@+id/playButton"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_play_button"
                android:contentDescription="@string/play_progression"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play_stop"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/chip_border" />

    <LinearLayout
        android:id="@+id/optionsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_background"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/barIndicator"
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:clickable="false"
                android:focusable="false"
                android:text="@string/bar_placeholder" />

            <TextView
                android:id="@+id/libraryButton"
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/improvisations" />

            <TextView
                android:id="@+id/progressionButton"
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/progression" />

            <TextView
                android:id="@+id/guidedButton"
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/guided_progressions" />

            <TextView
                android:id="@+id/scaleRootButton"
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/tonic_placeholder" />

            <TextView
                android:id="@+id/scaleButton"
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/scale_placeholder" />

            <TextView
                android:id="@+id/showScaleButton"
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/mode_scale" />

            <TextView
                android:id="@+id/showChordButton"
                style="@style/ChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/chord" />
        </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/chip_border" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/barProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="1000"
        android:progress="0"
        app:indicatorColor="@color/accent"
        app:trackColor="@color/chip_border"
        app:trackThickness="3dp" />

    <apk.mavier.dguitar.presentation.ui.FretboardView
        android:id="@+id/improvFretboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/improv_fretboard_description" />
</LinearLayout>
