<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/modulation_practice_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/practiceSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/playOriginButton"
                    style="@style/ChipButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/modulation_play_origin"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/playDestinationButton"
                    style="@style/ChipButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/modulation_play_destination"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/playFullButton"
                    style="@style/ChipButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:minHeight="44dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/modulation_play_full"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/modulation_tempo"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tempoSlow"
                    style="@style/ChipButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:minHeight="34dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/modulation_tempo_slow"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tempoMedium"
                    style="@style/ChipButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:minHeight="34dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/modulation_tempo_medium"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tempoFast"
                    style="@style/ChipButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:minHeight="34dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/modulation_tempo_fast"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1.1"
            android:orientation="vertical">

            <apk.mavier.dguitar.presentation.ui.ModulationPulseView
                android:id="@+id/pulseView"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/challengeTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/modulation_challenge_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/newChallengeButton"
                    style="@style/ChipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minHeight="34dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/modulation_new_challenge"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quizRow"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/challengeFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
